<mxfile host="drawio" agent="El Mejor Postor"><diagram id="01-ciclo-de-vida" name="Ciclo de vida del proyecto"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;El Mejor Postor · Ciclo de vida del proyecto (modelo iterativo e incremental)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;text;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1. Inicio y planificación&lt;/b&gt;&lt;hr&gt;Idea y alcance&lt;br&gt;Equipo y roles&lt;br&gt;Herramientas: Git, GitHub, Figma" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2. Análisis de requerimientos&lt;/b&gt;&lt;hr&gt;Actores y casos de uso&lt;br&gt;Requisitos funcionales y no funcionales&lt;br&gt;Reglas de negocio de la subasta" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3. Diseño&lt;/b&gt;&lt;hr&gt;Prototipo en Figma (10 pantallas)&lt;br&gt;Arquitectura cliente-servidor&lt;br&gt;Modelo de datos y API REST" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4. Implementación&lt;/b&gt;&lt;hr&gt;Backend ASP.NET Core 10&lt;br&gt;Frontend Vue 3&lt;br&gt;8 incrementos (ver abajo)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5. Pruebas&lt;/b&gt;&lt;hr&gt;41 pruebas xUnit de reglas de negocio&lt;br&gt;16 pruebas E2E con Playwright&lt;br&gt;Pruebas manuales" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6. Despliegue&lt;/b&gt;&lt;hr&gt;Docker Compose: SQL Server,&lt;br&gt;API y nginx + Vue&lt;br&gt;Datos de demostración" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;7. Mantenimiento y cierre&lt;/b&gt;&lt;hr&gt;Corrección de defectos&lt;br&gt;Mejoras pendientes&lt;br&gt;Cambio de nombre a El Mejor Postor" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fontSize=11;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="150" height="150" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroun