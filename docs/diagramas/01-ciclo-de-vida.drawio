Geometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="245"/><mxPoint x="445" y="245"/></Array></mxGeometry></mxCell><mxCell id="c17" value="nuevos requisitos (siguiente versión)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="275"/><mxPoint x="275" y="275"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Incrementos de la implementación&lt;/b&gt; (fechas tomadas del historial de Git)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;text;align=left;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="305" width="900" height="26" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Incremento 0&lt;/b&gt;&lt;br&gt;&lt;i&gt;25-oct&lt;/i&gt;&lt;br&gt;Base del proyecto&lt;br&gt;(commit inicial)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Incremento 1&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;API: plazo de pago, edición,&lt;br&gt;categorías, recuperación,&lt;br&gt;SQL Server" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="152" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Incremento 2&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Frontend: todas las&lt;br&gt;pantallas conectadas&lt;br&gt;a la API" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="284" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Incremento 3&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Docker Compose, datos&lt;br&gt;de demostración,&lt;br&gt;sesiones seguras" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="416" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Incremento 4&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Puja automática y&lt;br&gt;avisos por correo" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="548" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Incremento 5&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Pujas en tiempo real&lt;br&gt;con SignalR" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Incremento 6&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Perfil, paginación,&lt;br&gt;búsqueda y documentación&lt;br&gt;Scalar" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="812" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Incremento 7&lt;/b&gt;&lt;br&gt;&lt;i&gt;27-oct&lt;/i&gt;&lt;br&gt;Pruebas E2E con&lt;br&gt;Playwright, fotos&lt;br&gt;validadas" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="944" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Incremento 8&lt;/b&gt;&lt;br&gt;&lt;i&gt;30-oct&lt;/i&gt;&lt;br&gt;Cambio de nombre a&lt;br&gt;El Mejor Postor y&lt;br&gt;documentación" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=step;perimeter=stepPerimeter;size=12;fixedSize=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1076" y="340" width="122" height="96" as="geometry"/></mxCell><mxCell id="c28" value="Cada incremento pasa por análisis → diseño → código → pruebas antes de integrarse a la rama principal." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;text;align=left;strokeColor=none;fillColor=none;fontStyle=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="445" width="1180" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>