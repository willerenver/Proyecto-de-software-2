# Copia este archivo como .env y completa los valores. .env no se sube al repositorio.

# Contraseña del usuario sa de SQL Server: 8 caracteres o más, con mayúsculas, minúsculas, números y símbolos.
SA_PASSWORD=

# --- Solo producción (docker-compose.prod.yml) ---

# Clave para firmar las sesiones: 32 caracteres o más. Genera una con: openssl rand -base64 48
JWT_CLAVE=

# Dirección pública del sitio; va en los enlaces de los correos.
WEB_URL=https://subastas.ejemplo.com

# Servidor de correo.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
# Opcional: si se deja vacío, se usa SMTP_USUARIO como remitente.
SMTP_REMITENTE=

# Puerto donde escucha nginx en el servidor.
PUERTO_WEB=80
